@model IEnumerable<FitnessCenterApp.Models.Appointment>

@{
    ViewData["Title"] = "Randevu Yönetimi";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-2"><i class="fas fa-calendar-check me-2" style="color: var(--primary-color);"></i>Randevu Yönetimi</h2>
        <p class="text-muted">Randevuları görüntüleyin, onaylayın veya reddedin</p>
    </div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> Henüz randevu bulunmamaktadır.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Saat</th>
                    <th>Üye</th>
                    <th>Antrenör</th>
                    <th>Hizmet</th>
                    <th>Ücret</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model)
                {
                    <tr>
                        <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy")</td>
                        <td>@appointment.AppointmentTime.ToString(@"hh\:mm")</td>
                        <td>@(appointment.User?.FullName ?? "Bilinmiyor")</td>
                        <td>@appointment.Trainer.Name</td>
                        <td>@appointment.Service.Name</td>
                        <td>@appointment.TotalPrice.ToString("C")</td>
                        <td>
                            @if (appointment.IsConfirmed)
                            {
                                <span class="badge bg-success">Onaylandı</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Beklemede</span>
                            }
                        </td>
                        <td>
                            @if (!appointment.IsConfirmed)
                            {
                                <a asp-action="Approve" asp-route-id="@appointment.AppointmentId" 
                                   class="btn btn-sm btn-success">
                                    <i class="fas fa-check"></i> Onayla
                                </a>
                                <a asp-action="Reject" asp-route-id="@appointment.AppointmentId" 
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Bu randevuyu reddetmek istediğinizden emin misiniz?');">
                                    <i class="fas fa-times"></i> Reddet
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>

