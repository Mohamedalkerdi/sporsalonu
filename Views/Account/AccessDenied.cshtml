@{
    ViewData["Title"] = "Erişim Reddedildi";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="fas fa-ban text-danger" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="card-title mb-4">Erişim Reddedildi</h1>
                    <p class="card-text text-muted mb-4">
                        Üzgünüz, bu sayfaya erişim yetkiniz bulunmamaktadır. Bu sayfayı görüntülemek için gerekli yetkilere sahip değilsiniz.
                    </p>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <a asp-controller="Dashboard" asp-action="@(User.IsInRole("Admin") ? "AdminDashboard" : "UserDashboard")" class="btn btn-primary">
                                <i class="fas fa-home me-2"></i>Dashboard'a Dön
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                                <i class="fas fa-sign-in-alt me-2"></i>Giriş Yap
                            </a>
                        }
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Ana Sayfaya Dön
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 15px;
    }
    .card-body {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        border-radius: 15px;
    }
</style>

