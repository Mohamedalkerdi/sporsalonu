@model IEnumerable<FitnessCenterApp.Models.FitnessCenter>

@{
    ViewData["Title"] = "Spor Salonları";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-2"><i class="fas fa-building me-2" style="color: var(--primary-color);"></i>Spor Salonları</h2>
            <p class="text-muted">Spor salonlarını yönetin ve düzenleyin</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Yeni Spor Salonu Ekle
        </a>
    </div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Address)</th>
            <th>@Html.DisplayNameFor(model => model.Phone)</th>
            <th>Antrenör Sayısı</th>
            <th>Hizmet Sayısı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Address)</td>
                <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                <td>@item.Trainers.Count</td>
                <td>@item.Services.Count</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.FitnessCenterId" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit"></i> Düzenle
                    </a>
                    <a asp-action="WorkingHours" asp-route-id="@item.FitnessCenterId" class="btn btn-sm btn-info">
                        <i class="fas fa-clock"></i> Çalışma Saatleri
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.FitnessCenterId" class="btn btn-sm btn-danger" 
                       onclick="return confirm('Bu spor salonunu silmek istediğinizden emin misiniz?');">
                        <i class="fas fa-trash"></i> Sil
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

