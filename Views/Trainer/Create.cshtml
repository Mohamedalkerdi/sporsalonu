@model FitnessCenterApp.Models.Trainer

@{
    ViewData["Title"] = "Yeni Antrenör Ekle";
    var fitnessCenters = ViewBag.FitnessCenters as SelectList;
}

<div class="container py-5">
    <div class="text-center mb-5 fade-in-up">
        <h1 class="display-5 fw-bold mb-3" style="color: var(--text-dark);">
            <i class="fas fa-user-tie me-2" style="color: var(--primary-color);"></i>Yeni Antrenör Ekle
        </h1>
        <p class="lead text-muted">Yeni bir antrenör ekleyin</p>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-lg">
                <div class="card-header" style="background: var(--gradient-primary); color: white;">
                    <h5 class="mb-0"><i class="fas fa-user-plus me-2"></i>Antrenör Bilgileri</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <div class="form-group mb-4">
                            <label asp-for="Name" class="form-label fw-semibold">
                                <i class="fas fa-user me-2"></i>Antrenör Adı
                            </label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="Örn: Ahmet Yılmaz" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Expertise" class="form-label fw-semibold">
                                <i class="fas fa-star me-2"></i>Uzmanlık Alanı
                            </label>
                            <input asp-for="Expertise" class="form-control form-control-lg" placeholder="Örn: Kas Geliştirme, Kilo Verme, Yoga" />
                            <span asp-validation-for="Expertise" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="FitnessCenterId" class="form-label fw-semibold">
                                <i class="fas fa-building me-2"></i>Spor Salonu
                            </label>
                            <select asp-for="FitnessCenterId" class="form-select form-select-lg" asp-items="fitnessCenters">
                                <option value="">Seçiniz (Opsiyonel)</option>
                            </select>
                            <span asp-validation-for="FitnessCenterId" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg flex-fill">
                                <i class="fas fa-save me-2"></i>Kaydet
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-arrow-left me-2"></i>Geri Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
