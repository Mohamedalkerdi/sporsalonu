@model FitnessCenterApp.Models.TrainerAvailability

@{
    ViewData["Title"] = "Müsaitlik Saati Ekle";
    var trainerId = ViewBag.TrainerId;
    var daysOfWeek = ViewBag.DaysOfWeek as SelectList;
}

<h2>Müsaitlik Saati Ekle</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="AddAvailability">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TrainerId" value="@trainerId" />
            
            <div class="form-group mb-3">
                <label asp-for="DayOfWeek" class="control-label">Gün</label>
                <select asp-for="DayOfWeek" class="form-select" asp-items="daysOfWeek">
                    <option value="">Seçiniz</option>
                </select>
                <span asp-validation-for="DayOfWeek" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StartTime" class="control-label">Başlangıç Saati</label>
                <input asp-for="StartTime" class="form-control" type="time" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EndTime" class="control-label">Bitiş Saati</label>
                <input asp-for="EndTime" class="form-control" type="time" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Kaydet
                </button>
                <a asp-action="Availability" asp-route-id="@trainerId" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Geri Dön
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

